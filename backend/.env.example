# ---------------------------------------------------------
# L3o AI - Backend Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.
# ---------------------------------------------------------

# Your Mistral AI API key (get one at https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Model to use (Codestral is great for code + chat)
MISTRAL_MODEL=codestral-latest

# Comma-separated list of allowed frontend origins for CORS.
# Use "*" for development, or your deployed frontend URL in production.
# Example: https://l3o-ai.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=*

# Port the server binds to (Render sets this automatically)
PORT=8000
